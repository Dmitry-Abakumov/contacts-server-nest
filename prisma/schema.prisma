generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  favorite  Boolean  @default(false)
  
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String       @id @default(uuid())
  password          String
  email             String       @unique
  subscription      Subscription @default(starter)
  token             String?
  avatarURL         String
  verify            Boolean      @default(false)
  verificationToken String       @default(uuid())
  
  contacts          Contact[]   
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

enum Subscription {
  starter
  pro
  business
}